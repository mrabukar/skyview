# ---- Skyview API — production env ----
# Copy to api/.env and fill in real values. NEVER commit the real .env.

NODE_ENV=production

# Postgres. A local instance (127.0.0.1) or a managed provider (Neon, etc.)
# both work — see deploy/db-setup.sql for the local-Postgres bootstrap.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better-Auth — REQUIRED in production.
# Generate a 32+ char secret: `openssl rand -base64 48`
BETTER_AUTH_SECRET="CHANGE-ME-32-plus-random-characters"
# Public origin the API is reachable at — BARE ORIGIN ONLY, no path (not
# even "/api"). better-auth appends its own basePath ("/api/auth", set in
# auth.config.ts) on top of this — give it a URL that already has a path
# and it skips that append, then strips the wrong prefix off every
# incoming request and 404s on all of its own routes. See DEPLOY.md.
BETTER_AUTH_URL="https://tapiocataste.com"
# Comma-separated origins allowed to call the API with credentials — must
# include the web app's public origin(s).
BETTER_AUTH_TRUSTED_ORIGINS="https://tapiocataste.com,https://www.tapiocataste.com"

# Keep sign-up admin-only in production (leave unset, or "false").
# ALLOW_SIGNUP=false

PORT=5000
APP_TIMEZONE=Africa/Nairobi

# Seed values for the one-time org + first admin (see DEPLOY.md).
SEED_ORG_NAME=Skyview Coffee Ltd
SEED_ADMIN_EMAIL=admin@skyviewcoffee.co.ke
SEED_ADMIN_PASSWORD=CHANGE-ME-strong-Passw0rd!
SEED_ADMIN_NAME=Skyview Admin
