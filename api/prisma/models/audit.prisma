enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  STORE_CREATED
  STORE_UPDATED
  STORE_DEACTIVATED
  STORE_REACTIVATED
  VENDOR_CREATED
  VENDOR_UPDATED
  VENDOR_DEACTIVATED
  DAILY_SALE_CREATED
  DAILY_SALE_UPDATED
  DAILY_SALE_DELETED
  PURCHASE_CREATED
  PURCHASE_UPDATED
  PURCHASE_DELETED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EXPENSE_CATEGORY_CREATED
  EXPENSE_CATEGORY_UPDATED
  EXPENSE_CATEGORY_DELETED
  PAYROLL_RUN_EXECUTED
  SALARY_PAID
  ORGANIZATION_UPDATED
  REPORT_EXPORTED
  // ── POS module (Phase 2) ────────────────────────────────────────────────
  MENU_CATEGORY_CREATED
  MENU_CATEGORY_UPDATED
  MENU_CATEGORY_DEACTIVATED
  MENU_ITEM_CREATED
  MENU_ITEM_UPDATED
  MENU_ITEM_DEACTIVATED
  MENU_ITEM_SIZE_CREATED
  MENU_ITEM_SIZE_UPDATED
  MENU_ITEM_SIZE_DEACTIVATED
  TOPPING_CREATED
  TOPPING_UPDATED
  TOPPING_DEACTIVATED
  BRANCH_MENU_ITEM_UPDATED
  BRANCH_TOPPING_UPDATED
  POS_ORDER_CREATED
  POS_ORDER_PAID
  POS_ORDER_CANCELLED
  POS_ORDER_VOIDED
}

model AuditLog {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  action         AuditAction
  entityType     String
  entityId       String
  branchId       String?
  oldValue       Json?
  newValue       Json?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_log")
}
