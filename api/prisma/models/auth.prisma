enum UserRole {
  super_admin
  admin
  branch_manager
  cashier
}

model User {
  id             String        @id
  name           String        @default("")
  email          String
  emailVerified  Boolean       @default(false)
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  role           UserRole
  isActive       Boolean       @default(true)
  phone          String?
  /// Monthly salary in KSh — used by the payroll run (BR-6.1).
  salary         Decimal       @default(0) @db.Decimal(12, 2)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// Branch assignment. Required for branch_manager, null for admin (BR-7.3).
  /// For multi-branch managers this is the primary/default branch.
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  /// Page keys hidden from this branch_manager (admin-controlled). Empty = all
  /// pages visible. Ignored for admin/super_admin. See page registry (doc 10).
  disabledPages  String[]      @default([])

  /// ── Cashier-only fields (ignored for other roles) ──────────────────────────
  /// Days of week this cashier works, e.g. ["monday","tuesday","saturday"].
  /// Required when role = cashier (BR-POS-1.2).
  shiftDays      String[]      @default([])
  /// Shift window start in HH:mm, Africa/Nairobi (e.g. "07:00"). Cashier only.
  shiftStartTime String?
  /// Shift window end in HH:mm, Africa/Nairobi (e.g. "20:00"). Cashier only.
  shiftEndTime   String?
  /// Maximum discount percentage this cashier may apply per order (BR-POS-7.3).
  /// Null = cashier cannot give any discount.
  maxDiscountPercent Decimal?  @db.Decimal(5, 2)

  sessions               Session[]
  accounts               Account[]
  dailySales             DailySale[]               @relation("DailySalesEnteredBy")
  purchases              Purchase[]                @relation("PurchasesCreatedBy")
  expenses               Expense[]                 @relation("ExpensesCreatedBy")
  receipts               Receipt[]                 @relation("ReceiptsUploadedBy")
  attachments            UserAttachment[]          @relation("UserAttachments")
  uploadedAttachments    UserAttachment[]          @relation("UserAttachmentsUploadedBy")
  branchAssignments      BranchManagerAssignment[]
  auditLogs              AuditLog[]
  posOrders              PosOrder[]                @relation("PosOrdersCashier")
  voidedOrders           PosOrder[]                @relation("PosOrdersVoidedBy")
  createdMenuCategories  MenuCategory[]            @relation("MenuCategoriesCreatedBy")
  createdMenuItems       MenuItem[]                @relation("MenuItemsCreatedBy")
  createdToppings        Topping[]                 @relation("ToppingsCreatedBy")

  @@unique([email])
  @@index([organizationId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
