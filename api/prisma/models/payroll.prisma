/// One salary run per calendar month (BR-6). At most one per monthKey.
model PayrollRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Calendar month covered, `YYYY-MM`.
  monthKey       String
  totalAmount    Decimal      @db.Decimal(14, 2)
  userCount      Int
  paidAt         DateTime     @default(now())
  paidById       String
  paidBy         User         @relation("PayrollPaidBy", fields: [paidById], references: [id])

  items    PayrollRunItem[]
  expenses Expense[]

  /// BR-6.2 — at most one run per month per org.
  @@unique([organizationId, monthKey])
  @@map("payroll_run")
}

/// Immutable per-user snapshot at run time (BR-6.5).
model PayrollRunItem {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation("PayrollItemUser", fields: [userId], references: [id])
  userName   String
  salary     Decimal    @db.Decimal(12, 2)
  storeId    String?
  storeName  String?

  @@index([runId])
  @@map("payroll_run_item")
}
