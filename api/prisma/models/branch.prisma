/// Branch — a Bubble Tea Palace location.
model Branch {
  id             String       @id @default(cuid())
  name           String
  address        String
  isActive       Boolean      @default(true)
  /// When true, POS orders are the revenue source; new manual DailySale entries
  /// are blocked for this branch (BR-POS-8.2). Historical entries are preserved.
  posEnabled     Boolean      @default(false)
  /// Atomic counter for branch-scoped POS order numbers (BR-POS-6.9).
  /// Incremented in the same transaction as PosOrder creation.
  nextPosOrderNumber Int      @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users      User[]
  dailySales DailySale[]
  purchases  Purchase[]
  expenses   Expense[]
  receipts   Receipt[]
  managerAssignments   BranchManagerAssignment[]
  posOrders            PosOrder[]
  branchMenuItems      BranchMenuItem[]
  branchMenuItemPrices BranchMenuItemPrice[]
  branchToppings       BranchTopping[]

  @@unique([name, organizationId])
  @@map("branch")
}
