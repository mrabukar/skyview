/// One sales total per branch per calendar day (BR-2).
model DailySale {
  id             String       @id @default(cuid())
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  saleDate       DateTime     @db.Date
  totalAmount    Decimal      @db.Decimal(12, 2)
  note           String?
  enteredById    String
  enteredBy      User         @relation("DailySalesEnteredBy", fields: [enteredById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// BR-2.1 — exactly one entry per branch per day.
  @@unique([storeId, saleDate])
  @@index([organizationId])
  @@index([saleDate])
  @@index([storeId, saleDate])
  @@map("daily_sale")
}
