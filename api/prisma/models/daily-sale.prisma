/// One sales total per branch per calendar day (BR-2).
model DailySale {
  id             String       @id @default(cuid())
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  saleDate       DateTime     @db.Date
  totalAmount    Decimal      @db.Decimal(12, 2)
  note           String?
  enteredById    String
  enteredBy      User         @relation("DailySalesEnteredBy", fields: [enteredById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Multiple sales entries per branch per day are allowed.
  @@index([organizationId])
  @@index([saleDate])
  @@index([branchId, saleDate])
  @@map("daily_sale")
}
