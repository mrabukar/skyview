model ExpenseCategory {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  /// Seeded protected category (e.g. Salaries) — cannot be renamed/deleted (BR-5.5).
  isSystem       Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expenses Expense[]

  @@unique([name, organizationId])
  @@map("expense_category")
}

model Expense {
  id             String          @id @default(cuid())
  title          String
  amount         Decimal         @db.Decimal(12, 2)
  categoryId     Int
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  /// Null = company-wide expense (BR-5.1).
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  expenseDate    DateTime        @db.Date
  note           String?
  createdById    String
  createdBy      User            @relation("ExpensesCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([branchId, expenseDate])
  @@index([categoryId])
  @@map("expense")
}
