model ExpenseCategory {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  /// Seeded protected category (e.g. Salaries) — cannot be renamed/deleted (BR-5.5).
  isSystem       Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expenses Expense[]

  @@unique([name, organizationId])
  @@map("expense_category")
}

model Expense {
  id             String          @id @default(cuid())
  title          String
  amount         Decimal         @db.Decimal(12, 2)
  categoryId     Int
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  /// Null = company-wide expense (BR-5.1).
  storeId        String?
  store          Store?          @relation(fields: [storeId], references: [id])
  expenseDate    DateTime        @db.Date
  note           String?
  /// Set for payroll-generated salary expenses (BR-6.4).
  payrollRunId   String?
  payrollRun     PayrollRun?     @relation(fields: [payrollRunId], references: [id])
  createdById    String
  createdBy      User            @relation("ExpensesCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([storeId, expenseDate])
  @@index([categoryId])
  @@index([payrollRunId])
  @@map("expense")
}
