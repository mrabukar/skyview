model Organization {
  id            String    @id @default(cuid())
  name          String
  /// Multi-branch org. Always true for Skyview (kept for platform compatibility).
  hasStores     Boolean   @default(true)
  isActive      Boolean   @default(true)
  logoKey       String?
  logoUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users             User[]
  stores            Store[]
  vendors           Vendor[]
  dailySales        DailySale[]
  purchases         Purchase[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  payrollRuns       PayrollRun[]
  auditLogs         AuditLog[]

  @@map("organization")
}
