model Organization {
  id            String    @id @default(cuid())
  name          String
  /// Multi-branch org. Always true for Skyview (kept for platform compatibility).
  hasStores     Boolean   @default(true)
  isActive      Boolean   @default(true)
  logoKey       String?
  logoUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users             User[]
  branches          Branch[]
  vendors           Vendor[]
  dailySales        DailySale[]
  purchases         Purchase[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  auditLogs         AuditLog[]
  receipts          Receipt[]
  userAttachments   UserAttachment[]
  branchManagerAssignments BranchManagerAssignment[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  toppings          Topping[]
  posOrders         PosOrder[]

  @@map("organization")
}
