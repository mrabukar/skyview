# Neon PostgreSQL — use the direct (non-pooled) URL for migrations if pooled fails
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better-Auth
# Generate a 32+ byte secret: `npx auth secret` (or any random 32+ char string).
# Required in production.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:4000"
NODE_ENV=development

# Sign-up policy for POST /api/auth/sign-up/email
# true  = bootstrap mode (no admin session required — use briefly to create the first admin)
# false = admin-only sign-up (caller must be signed in as admin)
# Unset  = enabled in development, admin-only in production
# ALLOW_SIGNUP=false

PORT=4000

# Business calendar timezone (IANA). Drives "today"/"month" rules, reports, dashboards.
APP_TIMEZONE=Africa/Nairobi

# Seed configuration (full seed + individual seed scripts). Change before prod.
# Organization all partial seeds attach to (must match for seed:admin, etc.).
SEED_ORG_NAME=Skyview Coffee Ltd

SEED_ADMIN_EMAIL=admin@skyviewcoffee.co.ke
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Skyview Admin
SEED_ADMIN_SALARY=60000

SEED_MANAGER_EMAIL=catherine@skyviewcoffee.co.ke
SEED_MANAGER_PASSWORD=Manager123!
SEED_MANAGER_NAME=Catherine Wanjiru
SEED_MANAGER_SALARY=25000
# Branch the seeded manager is assigned to (must already exist for seed:manager).
SEED_MANAGER_BRANCH=Hub Mall – Karen
